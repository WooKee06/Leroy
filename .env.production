VITE_API_BASE=https://leroyserver.onrender.com/api
VITE_TELEGRAM_BOT_USERNAME=leroy_marketplace_bot
VITE_TON_NETWORK=mainnet
# Публичный адрес фронтенда. На Vercel можно не задавать: при сборке
# подставится домен деплоя (VERCEL_PROJECT_PRODUCTION_URL).
# После подключения своего домена — раскомментировать и указать его.
# VITE_PUBLIC_URL=https://your-domain.example
# Dev login is disabled in production.
VITE_DEV_AUTH=false
# VITE_TON_MANIFEST_URL=https://<set-your-frontend-domain>/tonconnect-manifest.json